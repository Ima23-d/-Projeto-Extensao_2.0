# ============================================================
#  DataInsight — .env.example
#  INSTRUÇÕES:
#  1. Copia este arquivo: cp .env.example .env
#  2. Preenche os valores reais no .env
#  3. NUNCA commite o .env no Git (já está no .gitignore)
# ============================================================

# ── Segurança Flask ──────────────────────────────────────────
# Gera uma chave aleatória: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=coloca_aqui_uma_chave_secreta_longa_e_aleatoria

# ── MongoDB ──────────────────────────────────────────────────
# Em Docker, o hostname é "mongo" (nome do serviço no docker-compose)
# Em desenvolvimento local, é "localhost"
MONGO_URI=mongodb://mongo:27017/datainsight

# ── Email (Flask-Mail) ───────────────────────────────────────
# Para Gmail: activa "App Passwords" nas definições de segurança da conta Google
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
EMAIL_USER=o_seu_email@gmail.com
EMAIL_PASS=a_seu_app_password_do_gmail

# ── Modo Flask ────────────────────────────────────────────────
# Em produção (Docker), usar "production"
# Em desenvolvimento local, usar "development"
FLASK_ENV=production
FLASK_DEBUG=0
